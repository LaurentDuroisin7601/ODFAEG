#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_nonuniform_qualifier : enable
#define NB_PRIMITIVE_TYPES 6
#define MAX_FRAMES_IN_FLIGHT 2
#define MAX_BONES_INFLUENCE 4
layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// Déclaration du type de primitive + limites
layout (triangles, max_vertices = 256, max_primitives = 256) out;
layout(location = 0) out vec4 fragColor[];
layout(location = 1) out vec2 fragTexCoord[];
layout(location = 2) out vec3 normal[];
layout(location = 3) flat out int materialID[];
layout(location = 4) flat out int primitiveType[];
layout(location = 5) flat out int currentFrame[];

struct MeshDrawCommand {
    uint groupXCount;
    uint groupYCount;
    uint groupZCount;
};
struct LODLevel {
    int index_offset;
    int index_count;
    int meshletOffset;
    int meshletCount;
};
struct TaskData {
    MeshDrawCommand meshDrawCommand;
    uint baseInstance;    
    uint vertexCount;
    uint primitiveCount;
    uint vertexOffset; 
    uint meshletCount;     
};
struct AABB {
	vec4 center;
	vec4 size;
};
struct Cluster {
    AABB volume;
    int meshletOffset;
    int meshletCount;
    int id;
    int lodLevel;
    int leaf;
    int submeshId;   
};
struct Vertex {
    vec3 position; ///< 3D position of the vertex    
    uint color; ///< Color of the vertex
    vec2 texCoords; ///< Coordinates of the texture's pixel to map to the vertex
    vec3 normal;
    vec3 T;  
    vec3 B;    
    vec3 N;    
    int submeshId;
    //bone indexes which will influence this vertex
    int m_BoneIDs[MAX_BONES_INFLUENCE];
    //weights from each bone
    float m_Weights[MAX_BONES_INFLUENCE];   
};
struct MeshLet {
    uint id;
    uint vertexOffset;
    uint indexOffset;
    uint nbVertices;
    uint nbIndexes;
    uint minVertex;
    uint maxVertex;				
    int clusterId;	
    uint lod;	
    int voxel;
    int rendered;
    int submeshId;
    vec4 mins;
    vec4 maxs;
    uint vertices[256];
    uvec4 triangles[256];
};
struct SubMesh {
	AABB globalBounds;
	int vertexOffset;
	int indexOffset;
	int primitiveType;
	int materialId;
	int nbVertices;
	int nbIndexes;
	int lodOffset;
	int id;
    int lodLevel;
    int objectId; 
    int meshletOffset;
	int meshletCount;	  
};

struct ModelData {
    mat4 modelMatrix;
    mat4 shadowProjMatrix;
    mat4 borderMatrices;
};
struct LodLevel {
    uint index_offset;
    uint nbLevels;
    int meshletOffset;
    int meshletCount;
};
struct TaskPayload {
    int taskId;
};
taskPayloadSharedEXT TaskPayload payload;
layout (push_constant) uniform PushConstant {
    mat4 projMatrix;
    mat4 viewMatrix;
    int primitiveType;
    int currentFrame;
} pc;
layout (std430, set = 0, binding = 0) buffer TastDataSSBO {
    TaskData taskData[];
} taskDatas[NB_PRIMITIVE_TYPES * MAX_FRAMES_IN_FLIGHT];
layout(std430, set = 0, binding = 1) buffer TaskCountSSBO {
    uint taskCount;
} TaskCounts[NB_PRIMITIVE_TYPES*MAX_FRAMES_IN_FLIGHT];
layout (std430, set = 0, binding = 2) buffer ModelDataSSBO {
    ModelData modelData[];
} modelDataBuffer[NB_PRIMITIVE_TYPES * MAX_FRAMES_IN_FLIGHT];
layout (std430, set = 0, binding = 3) buffer VisibleMeshletSSBO {
    uint meshlet[];
} visibleMeshletDatas[MAX_FRAMES_IN_FLIGHT*NB_PRIMITIVE_TYPES];
layout (std430, set = 0, binding = 4) buffer vertexBufferSSBO {
    Vertex vertices[];
} vertexData[NB_PRIMITIVE_TYPES];
layout (std430, set = 0, binding = 5) buffer indexBufferSSBO {
    uint indexes[];
} indexData[NB_PRIMITIVE_TYPES];
layout (std430, set=0, binding = 6) buffer LodLevelBuffer {
    LODLevel lodLevel[];
} lodLevelData;
layout (std430, set = 0, binding = 7) buffer SubMeshDataSSBO {
    SubMesh subMeshData[];
} SubMeshDatas;
layout (std430, set = 0, binding = 8) buffer MeshletsSSBO {
    MeshLet meshlet[];
} meshletDatas;

layout (std430, set = 0, binding = 9) buffer VerticesSSBO {
    Vertex vertices[];
} outputVertices[MAX_FRAMES_IN_FLIGHT];
vec4 unpackColor(uint c)
{
    float r = float((c >> 24) & 0xFFu) / 255.0;
    float g = float((c >> 16) & 0xFFu) / 255.0;
    float b = float((c >>  8) & 0xFFu) / 255.0;
    float a = float((c      ) & 0xFFu) / 255.0;

    return vec4(r, g, b, a);
}
uint globalIndices[256];
uint findLocalIndex(uint globalIndex, uint vertexCount) {
    for (uint i = 0; i < vertexCount; i++) {
        
        if (globalIndices[i] == globalIndex) {            
            return i;
        }
    }   
    return 0; // ne devrait jamais arriver
}
void main() {      
    
    TaskData taskData = taskDatas[pc.primitiveType*MAX_FRAMES_IN_FLIGHT+pc.currentFrame].taskData[payload.taskId];
    //debugPrintfEXT("base instance %i", taskData.baseInstance);
    if (pc.currentFrame >= MAX_FRAMES_IN_FLIGHT || pc.primitiveType > 3) {
        debugPrintfEXT("Current frame : %i %i", pc.currentFrame, pc.primitiveType);
    }
    /*if (taskData.vertexCount == 0)
        debugPrintfEXT("Error : %i", taskData.vertexCount);*/
    //Modèles 3D.
    if (taskData.vertexCount == 0) {  
        MeshLet meshlet = meshletDatas.meshlet[visibleMeshletDatas[pc.primitiveType*MAX_FRAMES_IN_FLIGHT+pc.currentFrame].meshlet[gl_WorkGroupID.y]];
        //Cluster cluster = clusterDatas[pc.primitiveType*MAX_FRAMES_IN_FLIGHT+pc.currentFrame].clusters[meshlet.clusterId];         
        //if (cluster.meshletCount > 8) {
            //debugPrintfEXT("meshlet count : %i %i", cluster.submeshId, cluster.meshletOffset);
        //}
        SubMesh subMesh = SubMeshDatas.subMeshData[meshlet.submeshId];
        
        //debugPrintfEXT("Submesh material : %i, %i", subMesh.id, subMesh.materialId);
      
        /*if (gl_WorkGroupID.z >= cluster.meshletCount) {
            return;
        }*/
        
        if (meshlet.rendered == 1) { 
            //debugPrintfEXT("Rendered");           
            return;
        }
        /*if (cluster.submeshId != subMesh.id || cluster.submeshId != meshlet.submeshId || meshlet.submeshId != subMesh.id) {
            debugPrintfEXT("error submesh %i %i %i lod : %i %i %i\n", cluster.submeshId, meshlet.submeshId, subMesh.id, cluster.lodLevel, subMesh.lodOffset, meshlet.lod);
        }*/
        
        //debugPrintfEXT("mesh shader"); 
        //Instance id = taskId (base instance) + workGroupId.x (instance id).
        uint instanceId = taskDatas[pc.primitiveType*MAX_FRAMES_IN_FLIGHT+pc.currentFrame].taskData[payload.taskId].baseInstance + gl_WorkGroupID.x;
        //debugPrintfEXT("Instance id : %i", gl_WorkGroupID.x); 
        mat4 modelMatrix = modelDataBuffer[pc.primitiveType*MAX_FRAMES_IN_FLIGHT+pc.currentFrame].modelData[instanceId].modelMatrix;
        //debugPrintfEXT("model matrix : %v4f \n%v4f \n%v4f \n%v4f\n", modelMatrix[0], modelMatrix[1], modelMatrix[2], modelMatrix[3]);
            
        
        
        //Avoid to render it twice if the meshlet is between two clusters. (Deduplication)
        
        //debugPrintfEXT("mesh shader"); 
        meshletDatas.meshlet[gl_WorkGroupID.y].rendered = 1;
        
        uint firstIndex = subMesh.indexOffset + lodLevelData.lodLevel[subMesh.lodOffset+meshlet.lod].index_offset + meshlet.indexOffset;
        //debugPrintfEXT("First index : %i,", firstIndex);
        //3 = Triangles.        
        uint vertexCount   = meshlet.nbVertices;
        uint primitiveCount = meshlet.nbIndexes / 3u;
        
            //debugPrintfEXT("vertex count : %i, primitive count : %i", vertexCount, primitiveCount);
        if (pc.primitiveType == 3) {
            SetMeshOutputsEXT(vertexCount, primitiveCount);
            for (uint i = 0; i < vertexCount; i++) {
                
                uint globalIndex = meshlet.vertices[i];
                
                //debugPrintfEXT("global index : %i %i", i, globalIndex);
                //uint v = subMesh.vertexOffset + meshlet.vertexOffset + i;                
                uint v = subMesh.vertexOffset + globalIndex;
                //if (subMesh.id == 0)
                    //debugPrintfEXT("offset %i", subMesh.vertexOffset);
                globalIndices[i] = globalIndex;
                groupMemoryBarrier();
                memoryBarrierBuffer();
                barrier();  
                
                vec4 color = unpackColor(vertexData[pc.primitiveType].vertices[v].color);
                if (color.r != 1 || color.g != 1 || color.b != 1 || color.a != 1)
                    debugPrintfEXT("error : %v4f", color);

            
                gl_MeshVerticesEXT[i].gl_Position = pc.projMatrix * pc.viewMatrix * modelMatrix * vec4(vertexData[pc.primitiveType].vertices[v].position.xyz, 1);
                //debugPrintfEXT("positions : %i, %v4f, %v3f\nModel matrix : %v4f,%v4f,%v4f,%v4f", subMesh.id, gl_MeshVerticesEXT[i].gl_Position, vertexData[pc.primitiveType].vertices[v].position.xyz, modelMatrix[0], modelMatrix[1], modelMatrix[2], modelMatrix[3]);
                //debugPrintfEXT("Proj matrix : %v4f,%v4f,%v4f,%v4f", pc.projMatrix[0], pc.projMatrix[1], pc.projMatrix[2], pc.projMatrix[3]);
                //debugPrintfEXT("View matrix : %v4f,%v4f,%v4f,%v4f", pc.viewMatrix[0], pc.viewMatrix[1], pc.viewMatrix[2], pc.viewMatrix[3]);
                //debugPrintfEXT("Model matrix : %v4f,%v4f,%v4f,%v4f", modelMatrix[0], modelMatrix[1], modelMatrix[2], modelMatrix[3]);
                /*if (subMesh.id == 0)
                debugPrintfEXT("offset : %i, position : %v3f", subMesh.vertexOffset, vertexData[pc.primitiveType].vertices[v].position);*/
                //debugPrintfEXT("vertex position %v3f : ",gl_MeshVerticesEXT[i].gl_Position);
                fragColor[i] = color;
                //debugPrintfEXT("color : %v4f", fragColor[i]);
                fragTexCoord[i] = vertexData[pc.primitiveType].vertices[v].texCoords;
                //debugPrintfEXT("tex coords : %v2f", fragTexCoord[i]);
                normal[i] = mat3(transpose(inverse(modelMatrix))) * vertexData[pc.primitiveType].vertices[v].normal.xyz;
                //debugPrintfEXT("normal %v3f", normal[i]);
                materialID[i] = subMesh.materialId;
                primitiveType[i] = pc.primitiveType;
                currentFrame[i] = pc.currentFrame;                
                //debugPrintfEXT("materialId %i", subMesh.materialId);
                //debugPrintfEXT("position : %i",  i);
            }  
                   
            for (uint tri = 0; tri < primitiveCount; tri++) {
               
                //debugPrintfEXT("gen tri : %i", tri);
                uint g0 = meshlet.triangles[tri].x;
                uint g1 = meshlet.triangles[tri].y;
                uint g2 = meshlet.triangles[tri].z;
                // Trouver les indices locaux
                uint i0 = findLocalIndex(g0, vertexCount);
                uint i1 = findLocalIndex(g1, vertexCount);
                uint i2 = findLocalIndex(g2, vertexCount);
                /*if (subMesh.id == 0)*/
                    //debugPrintfEXT("submesh id : %i triangle : %i, %i, %i %i %i %i", subMesh.id, g0, g1, g2, i0, i1, i2);
                /*uint g0 = indexData[pc.primitiveType].indexes[firstIndex+tri*3+0];
                uint g1 = indexData[pc.primitiveType].indexes[firstIndex+tri*3+1];
                uint g2 = indexData[pc.primitiveType].indexes[firstIndex+tri*3+2];
                uint i0 = g0 - meshlet.vertexOffset;
                uint i1 = g1 - meshlet.vertexOffset;
                uint i2 = g2 - meshlet.vertexOffset;*/
                //debugPrintfEXT("indexes : %i, %i, %i, %i %i %i",g0, g1, g2, i0, i1, i2);
                //debugPrintfEXT("indexes : %i, %i", vertexCount, primitiveCount);  
                if (i0 >= vertexCount || i1 >= vertexCount || i2 >= vertexCount) {
                    
                    debugPrintfEXT("erreur : %i %i %i, %i,%i, %i, %i, %i",g0, g1, g2, i0, i1, i2, meshlet.nbIndexes, vertexCount); 
                    //continue;
                }
                gl_PrimitiveTriangleIndicesEXT[tri] = uvec3(i0, i1, i2);            
            }            
        } 
    //Face de heightmap ou voxel.
    } else {
        //debugPrintfEXT("Height Map");
        SetMeshOutputsEXT(taskData.vertexCount, taskData.primitiveCount);
        for (uint i = 0; i < taskData.vertexCount; i++) {        
            gl_MeshVerticesEXT[i].gl_Position = vec4(outputVertices[pc.currentFrame].vertices[taskData.vertexOffset+i].position.xyz, 1);        
        }
        for (uint tri = 0; tri < taskData.primitiveCount; tri++) {
            gl_PrimitiveTriangleIndicesEXT[tri*2] = uvec3(tri*4, tri*4+1, tri*4+2);
            gl_PrimitiveTriangleIndicesEXT[tri*2+1] = uvec3(tri*4, tri*4+2, tri*4+3);
        }
    }  
}