bool intersects (AABB first, AABB second) {
    float hx1 = first.size.x * 0.5;
    float hy1 = first.size.y * 0.5;
    float hz1 = first.size.z * 0.5;
    float hx2 = second.size.x * 0.5;
    float hy2 = second.size.y * 0.5;
    float hz2 = second.size.z * 0.5;
    //Check the mins and max medians positions.
    float minX1 = first.center.x - hx1;
    float minX2 = second.center.x - hx2;
    float minY1 = first.center.y - hy1;
    float minY2 = second.center.y - hy2;
    float minZ1 = first.center.z - hz1;
    float minZ2 = second.center.z - hz2;
    float maxX1 = first.center.x + hx1;
    float maxX2 = second.center.x + hx2;
    float maxY1 = first.center.y + hy1;
    float maxY2 = second.center.y + hy2;
    float maxZ1 = first.center.z + hz1;
    float maxZ2 = second.center.z + hz2;
    //If the medians overlap, our two boxes intersects.
    for (int i = 0; i < 3; i++) {
        if (i == 0) {
            if (minX1 > maxX2 || maxX1 < minX2)
                return false;
        } else if (i == 1) {
            if (minY1 > maxY2 || maxY1 < minY2)
                return false;
        } else {
            if (minZ1 > maxZ2 || maxZ1 < minZ2)
                return false;
        }
    }
    return true;
}
bool hasNeightbour(ivec3 pos, int lod, uint axe) {
    vec3 offset;
    if (axe == 0) {
        offset = ivec3(pos.x - ubo[pc.currentFrame].gridCellSize[lod].x, pos.y, pos.z);
    } else if (axe == 1) {
        offset = ivec3(pos.x + ubo[pc.currentFrame].gridCellSize[lod].x, pos.y, pos.z);
    } else if (axe == 2) {
        offset = ivec3(pos.x, pos.y - ubo[pc.currentFrame].gridCellSize[lod].y, pos.z);
    } else if (axe == 3) {
        offset = ivec3(pos.x, pos.y + ubo[pc.currentFrame].gridCellSize[lod].y, pos.z);
    } else if (axe == 4) {
        offset = ivec3(pos.x, pos.y, pos.z - ubo[pc.currentFrame].gridCellSize[lod].z);
    } else {
        offset = ivec3(pos.x, pos.y, pos.z + ubo[pc.currentFrame].gridCellSize[lod].z);
    }
    float gridEndX = ubo[pc.currentFrame].gridSize[lod].x * ubo[pc.currentFrame].gridCellSize[lod].x;
    float gridEndY = ubo[pc.currentFrame].gridSize[lod].y * ubo[pc.currentFrame].gridCellSize[lod].y;
    float gridEndZ = ubo[pc.currentFrame].gridSize[lod].z * ubo[pc.currentFrame].gridCellSize[lod].z;
    float gridStartX = ubo[pc.currentFrame].gridPos[lod].x * ubo[pc.currentFrame].gridCellSize[lod].x;
    float gridStartY = ubo[pc.currentFrame].gridPos[lod].y * ubo[pc.currentFrame].gridCellSize[lod].y;
    float gridStartZ = ubo[pc.currentFrame].gridPos[lod].z * ubo[pc.currentFrame].gridCellSize[lod].z;
    int cellId = int(floor(offset.x / ubo[pc.currentFrame].gridCellSize[lod].x) + floor(offset.y / ubo[pc.currentFrame].gridCellSize[lod].y) * ubo[pc.currentFrame].nbCellsPerRow[lod].x + floor(offset.z / ubo[pc.currentFrame].gridCellSize[lod].z) * ubo[pc.currentFrame].nbCellsPerRow[lod].y);
    if (offset.x < gridStartX || offset.y < gridStartY || offset.z < gridStartZ
        || offset.x >= gridEndX || offset.y >= gridEndY || offset.z >= gridEndZ
        || cellId  >= ubo[pc.currentFrame].gridCellCount[lod] || inputGridBuffer.grid[cellId].clusterId == -1) {
        return false;
    }
    bool hasNVoxel = false;
    /*int stack[32];
    int sp = 0;
    stack[sp++] = inputClustersBuffer.clusters[inputGridBuffer.grid[cellId].clusterId].id;
    while (sp > 0) {
        uint id = stack[sp--];
        Cluster n = inputClustersBuffer.clusters[id];
        if (!intersects(ubo[pc.currentFrame].frustrum, n.volume)) {
            continue;
        }
        if (n.leaf == 1) {
            if (n.lod == 0) {
                for (uint m = 0; m < n.meshletCount && !hasNVoxel; m++) {
                    if (inputMeshlet.meshlets[n.meshletOffset+m].voxel == 1) {
                        hasNVoxel = true;
                    }
                }
            }                               
        } else {
            for (uint c = 0; c < 8; c++) {
                stack[sp++] = n.children[c];
            }
        } 
    }*/
    return hasNVoxel;
}
